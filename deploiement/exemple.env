# Gestion MP PRO — réglages de mise en service (copier en .env, ne JAMAIS le publier).
# L'application ne lit aucun fichier .env elle-même (S0 n° 11) : Docker Compose lit ce fichier
# (--env-file .env) et passe les variables GESTIONMPPRO_* à l'application (ARCHITECTURE § 16).

# Nom sous lequel les postes joignent Gestion MP PRO (adresse HTTPS, QR codes, liens courriels).
GESTIONMPPRO_NOM=gestion-mp-pro.usine.lan

# Mot de passe de la base : long, unique, jamais réutilisé ailleurs. Lettres et chiffres
# SEULEMENT : il est inséré dans une URL de connexion, où @ / : # % le casseraient.
GESTIONMPPRO_MOT_DE_PASSE_BASE=

# Fuseau de l'usine : PostgreSQL et l'application (zoneinfo). Jamais posé sur le processus (C16).
GESTIONMPPRO_FUSEAU=Africa/Casablanca

# Processus uvicorn (un seul porte les tâches de fond).
GESTIONMPPRO_PROCESSUS=2

# Copie des sauvegardes HORS du serveur (vivement conseillée) : /copie, une fois le disque monté
# dans docker-compose.yml et donné au compte de l'image (sudo chown 10001:10001 …).
GESTIONMPPRO_SAUVEGARDES_COPIE=

# Version affichée par /api/sante (facultatif) : commit ou étiquette de la construction.
GESTIONMPPRO_VERSION=

# Courriels d'alerte et aperçu du lundi (facultatif) : sans serveur d'envoi, les alertes restent
# dans l'écran.
GESTIONMPPRO_SMTP_HOTE=
GESTIONMPPRO_SMTP_PORT=587
GESTIONMPPRO_SMTP_UTILISATEUR=
GESTIONMPPRO_SMTP_MOT_DE_PASSE=
GESTIONMPPRO_SMTP_EXPEDITEUR=

# Niveau du journal serveur : DEBUG, INFO, WARNING, ERROR ou CRITICAL.
GESTIONMPPRO_JOURNAL_NIVEAU=INFO
